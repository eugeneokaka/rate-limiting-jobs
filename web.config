<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="dist/main.js" />
        </rule>
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))" />
          <action type="None" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="32768" maxUrl="32768" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
